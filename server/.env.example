# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Required for /v1/categorize
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_MS=30000

# HS256 secret, at least 32 characters: openssl rand -base64 48
# Test tokens: npm run token:dev
JWT_SECRET=

# Static bearer tokens, comma separated (development or a private self-hosted server)
API_TOKENS=

# Allowed origins, comma separated. Required when NODE_ENV=production.
# Example: chrome-extension://<extension-id>
CORS_ORIGINS=

MAX_EMAILS_PER_REQUEST=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

APP_VERSION=1.0.0
GIT_SHA=dev
